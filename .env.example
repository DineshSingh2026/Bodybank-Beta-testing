# Copy to .env and fill in. Never commit the real .env.

DATABASE_URL=postgresql://bodybank:bodybank@localhost:5432/bodybank_tracker
PORT=3000

# Must be a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Set to "production" when deployed. This turns on secure cookies and HSTS,
# and makes a weak JWT_SECRET stop the boot instead of being a warning.
NODE_ENV=development

# Used by "npm run db:setup" to create or reset Dinesh's account
DEVELOPER_EMAIL=dinesh@bodybank.fit
DEVELOPER_PASSWORD=change-this-password
